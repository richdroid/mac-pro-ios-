<?xml version="1.0" encoding="UTF-8"?>
<!-- The sea and the wordmark from the first frame, so launch is never a blank pale screen. The sea fills the screen as
     SeaBackground does; the wordmark is pinned where Home draws it folded: 30 pt high, 6 pt under the top of the safe area,
     centred in it (left of the side column). -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="CHL-vc-001">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="CHL-sc-001">
            <objects>
                <viewController id="CHL-vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="CHL-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="LaunchSea" translatesAutoresizingMaskIntoConstraints="NO" id="CHL-sea-001">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchWord" translatesAutoresizingMaskIntoConstraints="NO" id="CHL-wd-001">
                                <rect key="frame" x="144" y="65" width="104.86" height="30"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="104.86" id="CHL-c1-001"/>
                                    <constraint firstAttribute="height" constant="30" id="CHL-c1-002"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="CHL-sa-001"/>
                        <color key="backgroundColor" name="LaunchColor"/>
                        <constraints>
                            <constraint firstItem="CHL-sea-001" firstAttribute="leading" secondItem="CHL-vw-001" secondAttribute="leading" id="CHL-c2-001"/>
                            <constraint firstItem="CHL-sea-001" firstAttribute="trailing" secondItem="CHL-vw-001" secondAttribute="trailing" id="CHL-c2-002"/>
                            <constraint firstItem="CHL-sea-001" firstAttribute="top" secondItem="CHL-vw-001" secondAttribute="top" id="CHL-c2-003"/>
                            <constraint firstItem="CHL-sea-001" firstAttribute="bottom" secondItem="CHL-vw-001" secondAttribute="bottom" id="CHL-c2-004"/>
                            <constraint firstItem="CHL-wd-001" firstAttribute="top" secondItem="CHL-sa-001" secondAttribute="top" constant="6" id="CHL-c3-001"/>
                            <constraint firstItem="CHL-wd-001" firstAttribute="centerX" secondItem="CHL-sa-001" secondAttribute="centerX" id="CHL-c3-002"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="CHL-fr-001" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchSea" width="480" height="1040"/>
        <image name="LaunchWord" width="104.86" height="30"/>
        <namedColor name="LaunchColor">
            <color red="0.859" green="0.914" blue="0.984" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
